CHANNEL_ACCESS_TOKEN=YOUR_LINE_CHANNEL_ACCESS_TOKEN
CHANNEL_SECRET=YOUR_LINE_CHANNEL_SECRET
OWNER_USER_ID=YOUR_LINE_USER_ID
PORT=3000
TZ=Asia/Taipei

# 提醒設定：固定在下次繳費日前幾天提醒（預設 14）
REMIND_BEFORE_DAYS=14

# 每日提醒時間（24 小時制）
REMIND_HOUR=9
REMIND_MINUTE=0

# 若你要固定回報到某個群組，可填群組 ID；不填則會依紀錄中的群組逐一推送
DEFAULT_GROUP_ID=
